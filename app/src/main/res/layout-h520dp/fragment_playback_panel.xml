<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.oxycblt.auxio.ui.AuxioToolbar
        android:id="@+id/playback_toolbar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/toolbar_playback"
        app:navigationIcon="@drawable/ic_down_24"
        app:subtitleCentered="true"
        app:subtitleTextAppearance="?attr/textAppearanceBodySmall"
        app:title="@string/lbl_playback"
        app:titleCentered="true"
        app:titleTextAppearance="?attr/textAppearanceLabelLargeEmphasized"
        tools:subtitle="@string/lbl_all_songs" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/playback_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_mid_medium"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintBottom_toTopOf="@+id/playback_info_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_toolbar"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Fork pessoal: letra no lugar da capa (tocar na capa alterna), do topo até o nome da música e na largura toda. Montada no código. -->
    <FrameLayout
        android:id="@+id/playback_lyrics"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/spacing_small"
        app:layout_constraintBottom_toTopOf="@+id/playback_info_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Fork pessoal: player no estilo do Music OLED. Título, artista e álbum centralizados. -->
    <LinearLayout
        android:id="@+id/playback_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/fork_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_toolbar"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:id="@+id/playback_song"
            style="@style/Widget.Auxio.TextView.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fallbackLineSpacing="false"
            android:gravity="center"
            android:textAlignment="center"
            tools:text="Song Name" />

        <TextView
            android:id="@+id/playback_artist"
            style="@style/Widget.Auxio.TextView.Secondary.Marquee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:fallbackLineSpacing="false"
            android:gravity="center"
            android:textAlignment="center"
            tools:text="Artist Name" />

        <!-- "Álbum · Ano". Tocar no ano abre os álbuns daquele ano. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp">

            <TextView
                android:id="@+id/playback_album"
                style="@style/Widget.Auxio.TextView.Secondary.Marquee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fallbackLineSpacing="false"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/playback_year"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Album Name" />

            <TextView
                android:id="@+id/playback_year"
                style="@style/Widget.Auxio.TextView.Secondary.Base"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fallbackLineSpacing="false"
                android:maxLines="1"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/playback_album"
                app:layout_constraintTop_toTopOf="parent"
                tools:text=" · 1997"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Marcadores, timer, menu, o que fazer quando acaba, aleatório. -->
    <LinearLayout
        android:id="@+id/fork_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:layout_marginEnd="@dimen/spacing_small"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/playback_seek_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_info_container">

        <ImageView
            android:id="@+id/fork_bookmarks"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_bookmarks"
            android:scaleType="center"
            android:src="@drawable/ic_bookmarks_24"
            app:tint="@color/sel_activatable_icon" />

        <ImageView
            android:id="@+id/fork_timer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_sleep_timer"
            android:scaleType="center"
            android:src="@drawable/ic_snooze_24"
            app:tint="@color/sel_activatable_icon" />

        <ImageView
            android:id="@+id/fork_more"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lbl_more"
            android:scaleType="center"
            android:src="@drawable/ic_more_24"
            app:tint="@color/sel_activatable_icon" />

        <ImageView
            android:id="@+id/fork_end_mode"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_end_mode"
            android:scaleType="center" />

        <ImageView
            android:id="@+id/fork_shuffle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_shuffle"
            android:scaleType="center"
            android:src="@drawable/ic_shuffle_off_24"
            app:tint="@color/sel_activatable_icon" />

    </LinearLayout>

    <org.oxycblt.auxio.playback.ui.StyledSeekBar
        android:id="@+id/playback_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        app:layout_constraintBottom_toTopOf="@+id/playback_controls_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fork_actions" />

    <org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout
        android:id="@+id/playback_controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="@dimen/spacing_medium"
        android:layout_marginBottom="@dimen/spacing_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playback_seek_bar"
        app:layout_constraintWidth_max="400dp">

        <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:spacing="@dimen/spacing_small">

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/fork_volume"
                style="@style/Widget.Auxio.Button.Playback.Plain.Side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_volume"
                app:icon="@drawable/ic_volume_24"
                app:iconSize="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_skip_prev"
                style="@style/Widget.Auxio.Button.Playback.Plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_skip_prev"
                app:icon="@drawable/ic_skip_prev_24"
                app:iconSize="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_play_pause"
                style="@style/Widget.Auxio.Button.Playback.Plain.PlayPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_play_pause"
                app:icon="@drawable/sel_playing_state_24"
                app:iconSize="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium"
                tools:icon="@drawable/ic_play_24" />

            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/playback_skip_next"
                style="@style/Widget.Auxio.Button.Playback.Plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_skip_next"
                app:icon="@drawable/ic_skip_next_24"
                app:iconSize="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

            <!-- Espaço vazio do lado direito, para o play ficar no meio (o equalizador saiu). -->
            <org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButton
                android:id="@+id/fork_spacer"
                style="@style/Widget.Auxio.Button.Playback.Plain.Side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:visibility="invisible"
                app:icon="@drawable/ic_volume_24"
                app:iconSize="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Medium" />

        </org.oxycblt.auxio.playback.ui.button.ScaledPlaybackButtonGroup>
    </org.oxycblt.auxio.playback.ui.ForcedLTRFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
