<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fork pessoal: linha das listas automáticas no topo da aba Playlists. -->
    <style name="Widget.Auxio.TextView.ForkAutoRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/spacing_medium</item>
        <item name="android:paddingEnd">@dimen/spacing_medium</item>
        <item name="android:drawablePadding">@dimen/spacing_large</item>
        <item name="android:drawableTint">?attr/colorOnSurface</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Fork pessoal: botões do player só com o ícone, sem fundo (como no Music OLED). -->
    <style name="Widget.Auxio.Button.Playback.Plain" parent="Widget.Material3Expressive.Button.IconButton.Tonal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Auxio.Button.Playback.Plain.Side">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Auxio.Button.Playback.Plain.PlayPause">
        <item name="android:checkable">true</item>
        <item name="toggleCheckedStateOnClick">false</item>
    </style>
</resources>
