<?xml version="1.0" encoding="utf-8"?>
<!-- Fork pessoal: filtro da aba Álbuns (nota e ano, combináveis). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/filter_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_medium">

        <TextView
            style="@style/Widget.Auxio.TextView.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lbl_filter_albums" />

        <Button
            android:id="@+id/filter_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_clear_filters" />

    </LinearLayout>

    <TextView
        style="@style/Widget.Auxio.TextView.Header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lbl_rating" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/filter_ratings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_medium"
        app:chipSpacingHorizontal="@dimen/spacing_tiny" />

    <TextView
        style="@style/Widget.Auxio.TextView.Header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lbl_year" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_medium">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filter_years"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_medium"
            app:chipSpacingHorizontal="@dimen/spacing_tiny" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
